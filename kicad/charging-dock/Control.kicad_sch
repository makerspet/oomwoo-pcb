	(text "CH32V003F4P6: PA2 = VIN_SENSE (A0), PA1 = DOCK_SENSE (A1), PD2 = PROBE_A (A3), PD3 = I_SENSE (A4),\nPC1 = CHG_EN (high = DOCK+ on), PC2 = PROBE_DRV, PC3/PC4 = IR_L/IR_R (TIM1_CH3/CH4, 38 kHz),\nPC0 = status LED, PD4 = IR_RX (TIM2_CH1), PD5/PD6 = UART, PD1 = SWIO. HSI clock, no crystal.\nADC reference is VDD, and PROBE_DRV high is VDD too, so the probe math is ratiometric."
		(exclude_from_sim no)
		(at 101.6 165.1 0)
		(effects
