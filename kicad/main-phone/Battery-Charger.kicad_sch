	(text "DC-IN-20V: 20 V brick or dock. With the battery disconnected (Q14 off) VBAT-14V4 = DC-IN-20V - 0.4 V,\nso the SLM6900 (95% max duty) needs >= ~18.5 V to finish a 4S charge. Keep DC-IN-20V <= 22 V (D41, Q13 Vgs)."
		(exclude_from_sim no)
		(at 62.738 29.972 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "8494b442-f1ad-41c3-9a09-dc5873f8ea93")
	)
