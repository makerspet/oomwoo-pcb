	(text "Bumpers: 2x ITR9606 slotted photo-interrupters on the main board (~11 mm tall, set by the bumper\nmechanism). Emitters in series from VSENS-5V-USB, switched by BUMPER_LED_EN (high = on, 100k pull-down).\nBUMP-x-Q+ reads low when light passes the slot (R44/R48 47k pull-ups)."
		(exclude_from_sim no)
		(at 27.94 168.91 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "0c66b067-8b43-44df-824a-83eeaadf8f92")
	)
	(text "Cliff sensors: 6 boards (kicad/cliff-sensor), SH 4-pin vertical: 1 VSENS-5V-USB (LED, 150R on the board),\n2 CLIFF-LED-K (Q35 sinks all 6 LEDs), 3 phototransistor collector (47k pull-up), 4 GND.\nModulate CLIFF_LED_EN and read each channel LED-on minus LED-off to cancel ambient light.\nADC: LF PA3, RF PA1, LR PA2, RR PA0, LM PD9, RM PE8 (LM/RM via global labels)."
		(exclude_from_sim no)
		(at 27.94 151.13 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "396295f3-44e3-4454-9ed4-e16dfb38ba75")
	)
	(text "ANTI FALL SENSORs"
		(exclude_from_sim no)
		(at 88.9 34.29 0)
		(effects
			(font
				(size 3.048 3.048)
				(thickness 0.6096)
				(bold yes)
				(italic yes)
			)
			(justify left bottom)
		)
		(uuid "b98b61a9-919a-4465-9788-2121ef3a93d9")
	)
