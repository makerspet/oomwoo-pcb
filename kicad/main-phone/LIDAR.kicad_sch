	)
	(text "VM-5V-LIDAR powers the whole LiDAR (laser included) for any model. On only while WD_OK is high\nAND LiDAR-EN is low (Q7003 source-switched AND). R7006/C7003: ~1.5 ms soft start, ~30 ms soft stop.\nLIDAR2: 0.1in header for other LiDARs (pin 2 now GND)."
		(exclude_from_sim no)
		(at 60.325 35.56 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "5161315e-5b08-4f10-a84b-faaf83fb55e0")
	)
	(text "LIDAR2 and STM32_DEBUG1 use the same right-angle 1x5 0.1in header\n(PZ254R-11-05P), one BOM line. LIDAR2 pin 5 is unused."
		(exclude_from_sim no)
		(at 190.5 172.72 0)
