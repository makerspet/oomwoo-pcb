				(size 1.27 1.27)
				(color 255 0 255 1)
			)
		)
		(uuid "e315ca8c-0c36-453e-88aa-756760dbdf36")
	)
	(text "TPS54560B (U21, U22): non-synchronous,\nSS56 catch diode; fsw 418 kHz (RT 232k);\nCOMP 4.7k + 47nF (all-ceramic Cout, no pole cap).\nEN abs max 8.4 V: R207/R208 on U21."
		(exclude_from_sim no)
		(at 15.24 250.19 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "fbb1d7fe-0e6c-4149-98d9-73391c935980")
	)
