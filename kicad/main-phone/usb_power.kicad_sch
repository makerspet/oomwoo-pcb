	(text "USB-C for SMARTPHONE"
		(exclude_from_sim no)
		(at 18.796 26.924 0)
		(effects
			(font
				(size 3.048 3.048)
				(thickness 0.6096)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "071dbbf8-0cf0-4b7b-a43a-922f88ba4084")
	)
	(text "VBUS_5V lockout: the robot 5 V (TMI6240 + Q27) can only\nturn on while VBUS_5V is ~0 V. Q33 holds PWR_EN_G low if a\nphone already sources VBUS_5V; once on, Q34 latches it.\n\nPD power-role swap lets the robot charge the phone while it stays host. Q27 blocks the phone's\nVBUS_5V from back-feeding the robot 5 V (the TMI6240 body diode conducts VOUT->VIN);\nUSB_PWR_EN turns on TMI6240 and Q27 together.\nTMI6240 now runs from VSENS-5V-USB (U25 buck removed)."
		(exclude_from_sim no)
		(at 42.672 133.604 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "2e48c1f9-9ef5-442e-9a2d-e3b868dfade2")
	)
	(text "USB-C (phone): phone is the USB host. CC1/CC2 go to the STM32 UCPD (PB6/PB4): Rd by default."
		(exclude_from_sim no)
		(at 156.718 130.302 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "41c3bc55-4606-4ddf-a7d6-287a90767fc0")
	)
	(text "Not required"
