	(text "RC CHARGE-PUMP WATCHDOG: WD_OK gates VM-VBAT, VM-5V-LIDAR and VM-5V-WATER-PUMP"
		(exclude_from_sim no)
		(at 259.08 252.73 0)
		(effects
			(font
				(size 1.778 1.778)
				(thickness 0.3556)
