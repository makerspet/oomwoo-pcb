	(text "J5001 to the main board REAR-IR1, pin 1 to pin 1:\n1 3.3 V, 2 IR_L, 3 IR_R, 4 GND"
		(exclude_from_sim no)
		(at 38.1 127 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "2a00e9d8-fc3f-4fb4-a269-7e751fd7c013")
	)
	(text "OOMWOO rear docking IR board (rev 1, 2026-10-28). Two top-looking 38 kHz receivers (the same part as the side board\nand the dock's U1202) look out of the board face, which faces backward. Put them ~10 mm apart with a baffle between\nthem: both see the dock = it is straight behind, one = steer that way. The outputs have internal pull-ups.\nRefs in the 5000s: each board has its own range."
		(exclude_from_sim no)
		(at 30.48 39.624 0)
		(effects
			(font
				(size 1.524 1.524)
			)
			(justify left bottom)
		)
		(uuid "867c334c-f4f6-405e-8968-ab0ca26ba581")
	)
	(text "Mounting: 2x M2 (pads to GND)"
		(exclude_from_sim no)
		(at 73.66 144.78 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "8d096893-a4b9-40ee-93d9-337aaaa24d60")
	)
	(text "U5001 = left, U5002 = right, seen from behind the robot\n(looking at the board face)."
		(exclude_from_sim no)
		(at 127 160.02 0)
		(effects
